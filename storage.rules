rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Upload guard: raster image payload under the bucket ceiling (rejects SVG scripts).
    function isImageUnder(maxBytes) {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.size <= maxBytes;
    }

    // Public book covers, writable by authenticated catalog maintainers.
    //
    // SEC-03: covers are shared catalog assets, so clients may create and
    // replace them but never delete them — destructive removal stays with the
    // trusted admin/Cloud Function path. Uploads must be images under 5 MB.
    match /book-covers/{bookId}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImageUnder(5 * 1024 * 1024);
      allow delete: if false;
    }

    // User avatars: world readable, owner writable.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isImageUnder(2 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    // Everything else is denied by default in Firebase Storage rules.
  }
}
