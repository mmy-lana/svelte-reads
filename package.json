{
  "name": "svelte-reads",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "verify": "pnpm run check && pnpm run test && pnpm run build",
    "verify:atoms": "node scripts/verify-atoms.ts",
    "emulator:up": "docker compose up -d --build",
    "emulator:down": "docker compose down",
    "emulator:logs": "docker compose logs -f firebase-emulator",
    "emulator:seed": "node scripts/seed-emulator.ts",
    "emulator:verify": "node scripts/verify-emulator.ts"
  },
  "dependencies": {
    "firebase": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "^26.6.2",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "^5.0.1"
  }
}
