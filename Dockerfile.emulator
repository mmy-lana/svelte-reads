# Firebase Emulator Suite (Auth, Firestore, Storage, UI) for the Book Review Community Platform.
# Debian trixie ships OpenJDK 21, which firebase-tools requires for the Firestore emulator.
FROM node:22-trixie-slim

# FIREBASE_TOOLS_VERSION defaults to the newest release published on the npm registry.
# Override at build time (docker compose build --build-arg FIREBASE_TOOLS_VERSION=13.31.0) to pin.
ARG FIREBASE_TOOLS_VERSION=latest
# GCP_PROJECT must match VITE_FIREBASE_PROJECT_ID in .env for single-project emulator mode.
ARG GCP_PROJECT=book-review-community-dev

ENV DEBIAN_FRONTEND=noninteractive \
    GCP_PROJECT=${GCP_PROJECT} \
    FIREBASE_TOOLS_VERSION=${FIREBASE_TOOLS_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openjdk-21-jre-headless \
        curl \
        bash \
        ca-certificates \
    && java -version \
    && npm install -g "firebase-tools@${FIREBASE_TOOLS_VERSION}" \
    && npm cache clean --force \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/workspace

# 4000 = Emulator UI hub, 8080 = Firestore, 9099 = Auth, 9199 = Storage
EXPOSE 4000 8080 9099 9199

# Fail fast with a readable message instead of an opaque firebase error when a
# configuration file is not mounted into the workspace.
RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'for required in firebase.json firestore.rules firestore.indexes.json storage.rules; do' \
    '  if [ ! -f "/opt/workspace/${required}" ]; then' \
    '    echo "[emulator] FATAL: /opt/workspace/${required} is missing. Mount it via docker-compose.yml." >&2' \
    '    exit 1' \
    '  fi' \
    'done' \
    'exec firebase emulators:start --project "${GCP_PROJECT}" --config /opt/workspace/firebase.json' \
    > /usr/local/bin/start-emulators.sh \
    && chmod +x /usr/local/bin/start-emulators.sh

HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=12 \
    CMD curl -fsS "http://127.0.0.1:4000/" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/start-emulators.sh"]
